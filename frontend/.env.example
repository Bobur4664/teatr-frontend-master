# Copy to .env for local development. Vite reads these; Docker builds ignore .env.

# Which API to talk to. Without this, `npm run dev` uses http://localhost:8000/api.
# Pointing it at https://api.eteatr.uz/api means real data: likes and comments
# you submit from your machine go live.
VITE_API_URL="http://localhost:8000/api"

# Force one theatre. Without this, the theatre comes from the URL subdomain
# (kukla.localhost:3001 -> kukla), or `th1` when there is none.
# VITE_THEATER_SLUG="kukla"
